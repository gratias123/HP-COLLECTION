# ==============================================================================
# HP COLLECTION — CONFIGURATION VARIABLES D'ENVIRONNEMENT DE PRODUCTION
# ==============================================================================
# ATTENTION DEVOPS :
# 1. Ne JAMAIS commiter de fichier .env ou .env.production contenant de vrais secrets.
# 2. Permissions recommandées sur le serveur : chmod 600 .env.production
# 3. Sur les plateformes Cloud (Google Cloud Run, AWS ECS, Railway), injecter ces
#    variables via le Secret Manager ou le panneau de variables d'environnement.
# ==============================================================================

# --- ENVIRONNEMENT DU RUNTIME NODE.JS ---
NODE_ENV="production"
PORT=3000

# --- URL OFFICIELLE EN PRODUCTION (HTTPS OBLIGATOIRE) ---
# Doit correspondre exactement au domaine personnalisé configuré (ex: https://hpcollection.bj)
APP_URL="https://hpcollection.bj"

# --- GOOGLE GEMINI AI API (ASSISTANT STYLE & CONSEILLER CLIENT) ---
# Générez votre clé de production sur Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY="AIzaSyYourProductionGeminiApiKeyHere"

# --- FEDAPAY BÉNIN — MOBILE MONEY EN PRODUCTION (MTN / MOOV / CELTIIS) ---
# Clés de production délivrées par https://fedapay.com après validation KYC du marchand
FEDAPAY_PUBLIC_KEY="VOTRE_CLE_PUBLIQUE_FEDAPAY"
FEDAPAY_SECRET_KEY="VOTRE_CLE_SECRETE_FEDAPAY"

# --- META WHATSAPP BUSINESS CLOUD API (NOTIFICATIONS CLIENTS & ADMIN) ---
# Optionnel. Si non renseigné, le simulateur Sandbox Bénin prend le relais automatiquement.
# Obtenu via Meta Business Suite (https://business.facebook.com) > WhatsApp > Configuration API
WHATSAPP_PHONE_NUMBER_ID="109876543210987"
WHATSAPP_ACCESS_TOKEN="EAABxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- SERVEUR SMTP TRANSACTIONNEL (CONFIRMATION COMMANDE & EXPÉDITION) ---
# Fournisseur SMTP recommandé : Resend, Brevo, Mailgun, ou serveur SMTP dédié
SMTP_HOST="smtp.resend.com"
SMTP_PORT=587
SMTP_USER="resend"
SMTP_PASS="re_xxxxxxxxxxxxxxxxxxxxxxxx"
SMTP_FROM="commandes@hpcollection.bj"

# --- GOOGLE SEARCH CONSOLE & GOOGLE ANALYTICS 4 ---
# Balise de vérification du domaine béninois dans la Search Console
GOOGLE_SITE_VERIFICATION="google-site-verification-token-hp-collection"
# Identifiant de mesure GA4 pour le suivi e-commerce (panier, conversions FedaPay)
VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# --- POLITIQUE DE SAUVEGARDE & RÉTENTION ---
# Nombre de snapshots quotidiens conservés avant rotation automatique
BACKUP_RETENTION_DAYS=14
