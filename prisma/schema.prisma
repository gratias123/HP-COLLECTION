// HP COLLECTION — Prisma Schema
// Optimisé pour Vercel Postgres, Neon, Supabase & AWS RDS

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Category {
  id           String    @id
  name         String
  description  String?
  icon         String?
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  products     Product[]
}

model Product {
  id          String           @id
  sku         String           @unique
  name        String
  description String
  price       Int
  salePrice   Int?
  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id])
  images      Json
  isFeatured  Boolean          @default(false)
  isTrending  Boolean          @default(false)
  totalStock  Int              @default(0)
  viewCount   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  variants    ProductVariant[]
}

model ProductVariant {
  id        String   @id
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String   @unique
  size      String
  color     String
  stock     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([size])
}

model Customer {
  id          String   @id
  fullName    String
  phone       String   @unique
  email       String?
  city        String
  district    String?
  address     String?
  totalOrders Int      @default(0)
  totalSpent  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]
}

model DeliveryZone {
  id             String  @id
  name           String
  fee            Int
  estimatedHours String
  isActive       Boolean @default(true)
}

model PromoCode {
  id             String    @id
  code           String    @unique
  discountType   String
  discountValue  Int
  minOrderAmount Int       @default(0)
  maxUses        Int?
  usedCount      Int       @default(0)
  isActive       Boolean   @default(true)
  expiresAt      DateTime?
}

model Order {
  id                   String      @id
  orderNumber          String      @unique
  customerId           String?
  customer             Customer?   @relation(fields: [customerId], references: [id])
  customerSnapshot     Json
  subtotal             Int
  shippingFee          Int         @default(0)
  discountAmount       Int         @default(0)
  total                Int
  promoCode            String?
  paymentMethod        String
  paymentStatus        String      @default("pending")
  fulfillmentStatus    String      @default("pending")
  fedapayTransactionId String?
  notes                String?
  statusHistory        Json        @default("[]")
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  items                OrderItem[]

  @@index([orderNumber])
  @@index([paymentStatus])
  @@index([fulfillmentStatus])
}

model OrderItem {
  id        String   @id
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  variantId String?
  name      String
  sku       String
  size      String
  color     String
  price     Int
  quantity  Int
  image     String?

  @@index([orderId])
}

model StockMovement {
  id            String   @id
  productId     String
  variantId     String
  sku           String
  change        Int
  previousStock Int
  newStock      Int
  reason        String
  orderId       String?
  timestamp     DateTime @default(now())
}

model AdminUser {
  id           String         @id
  email        String         @unique
  fullName     String
  passwordHash String
  salt         String
  algorithm    String         @default("scrypt")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]
}

model AdminSession {
  id        String    @id
  token     String    @unique
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String    @default("admin")
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([token])
}
